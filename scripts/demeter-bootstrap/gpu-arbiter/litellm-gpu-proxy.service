[Unit]
Description=Demeter LiteLLM GPU Proxy (auto-acquire LLM for Cursor)
After=network-online.target demeter-gpu-arbiter.service
Wants=network-online.target demeter-gpu-arbiter.service

[Service]
Type=simple
Environment=PINOKIO_HOME=/mnt/ia/pinokio
Environment=LITELLM_PROXY_PORT=4000
Environment=LITELLM_UPSTREAM_PORT=4001
Environment=GPU_ARBITER_URL=http://127.0.0.1:8790
Environment=GPU_ARBITER_OWNER=litellm-proxy
ExecStart=/usr/bin/python3 %h/Documents/devforge/scripts/demeter-bootstrap/gpu-arbiter/litellm-gpu-proxy.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
