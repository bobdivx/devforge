# Copier vers scripts/devforge-deploy.env et renseigner vos valeurs.
# scripts/devforge-deploy.env est ignore par git (ne pas committer le mot de passe).

# SSH NAS
NAS_HOST=10.1.0.58
NAS_USER=bobdivx
NAS_SSH_PASSWORD=

# Optionnel : cle SSH (prioritaire sur le mot de passe si le fichier existe)
# NAS_SSH_KEY_PATH=C:\Users\auber\.ssh\devforge_nas_ed25519
# Ou variable d'environnement : DEVFORGE_SSH_KEY=C:\Users\auber\.ssh\devforge_nas_ed25519

# Mode deploiement:
#   images  — stack Docker DevForge (devforge-api / web / db / redis / proxy) [defaut]
#   overlay — patch du conteneur legacy coolify (transition uniquement)
DEPLOY_MODE=images

# Overlay only (DEPLOY_MODE=overlay)
NAS_CONTAINER=coolify
# NAS_ENV_FILE=/data/coolify/source/.env

# Images / compose on NAS
# NAS_COMPOSE_DIR=/media/Docker/AppData/devforge/source
# NAS_DEVFORGE_DATA_DIR=/DATA/.devforge
# DEVFORGE_DATA_ROOT=/media/Docker/AppData/devforge

# sudo sur le NAS pour le .env hote si necessaire (true/false)
NAS_USE_SUDO=false
