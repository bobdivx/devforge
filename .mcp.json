{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "graft": {
            "command": "npx",
            "args": [
                "graft",
                "mcp",
                "/workspace"
            ],
            "env": {}
        }
    }
}