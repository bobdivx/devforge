---
import { App } from '../components/App';
import { DEVFORGE_FAVICON_URL, DEVFORGE_LOGO_URL } from '../lib/brand';
import { staticRoutePaths } from '../lib/routes';
import '../styles/global.css';

export function getStaticPaths() {
    return staticRoutePaths.map((routePath) => ({
        params: {
            path: routePath === '/' ? undefined : routePath.slice(1),
        },
        props: {
            initialPath: routePath,
        },
    }));
}

const { initialPath } = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="Interface DevForge pour administrer serveurs, applications et bases." />
        <meta name="theme-color" content="#171717" />
        <link rel="icon" href={DEVFORGE_FAVICON_URL} sizes="any" />
        <link rel="icon" href={DEVFORGE_LOGO_URL} type="image/png" />
        <link rel="apple-touch-icon" href={DEVFORGE_LOGO_URL} />
        <title>DevForge</title>
        <script is:inline>
            (() => {
                const saved = localStorage.getItem('devforge-theme');
                const theme = saved === 'light' || saved === 'dark'
                    ? saved
                    : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
            })();
        </script>
    </head>
    <body>
        <script is:inline>
            setTimeout(() => {
                const island = document.querySelector('astro-island[ssr]');
                if (!island) {
                    return;
                }

                island.innerHTML = `
                    <div style="min-height:18rem;display:grid;place-items:center;padding:1.5rem;font-family:system-ui,sans-serif;">
                        <div style="max-width:28rem;text-align:center;border:1px solid #404040;border-radius:0.75rem;padding:1.25rem;background:#171717;color:#e5e5e5;">
                            <p style="font-weight:600;margin:0 0 0.5rem;">Interface DevForge non chargée</p>
                            <p style="margin:0 0 1rem;font-size:0.875rem;opacity:0.75;">
                                Le JavaScript n'a pas pu démarrer (build incomplet ou cache navigateur).
                                Reconstruisez DevForge sur le serveur, puis rechargez sans cache.
                            </p>
                            <button type="button" onclick="location.reload()" style="cursor:pointer;border:1px solid #525252;background:#262626;color:inherit;border-radius:0.5rem;padding:0.45rem 0.9rem;font-size:0.875rem;">
                                Recharger
                            </button>
                        </div>
                    </div>
                `;
            }, 15000);
        </script>
        <App initialPath={initialPath} client:load />
    </body>
</html>
