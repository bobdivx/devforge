{
    "extends": "../node_modules/astro/tsconfigs/strict.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "types": [
            "vitest/globals",
            "@testing-library/jest-dom"
        ]
    },
    "include": [
        ".astro/types.d.ts",
        "src/**/*.astro",
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "dist",
        "tests"
    ]
}
