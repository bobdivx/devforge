---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'DevForge', description = 'Deploy with clarity. Agents that work.' } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      (function () {
        if (window.__dfViewTransitionGuard) return;
        window.__dfViewTransitionGuard = true;

        var proto = Animation.prototype;
        if (proto.commitStyles && !proto.__dfCommitStyles) {
          var nativeCommit = proto.commitStyles;
          proto.commitStyles = function () {
            try {
              return nativeCommit.apply(this, arguments);
            } catch (err) {
              if (!err || err.name !== 'InvalidStateError') throw err;
            }
          };
          proto.__dfCommitStyles = true;
        }

        // Démonte les îlots tant que l’arbre DOM est encore en place.
        // Sinon astro:unmount arrive après le swap, sur un nœud détaché,
        // et Preact lève insertBefore.
        document.addEventListener('astro:before-swap', function () {
          document.querySelectorAll('astro-island:not([data-astro-transition-persist])').forEach(function (el) {
            if (typeof el.getAnimations === 'function') {
              el.getAnimations({ subtree: true }).forEach(function (animation) {
                try {
                  animation.cancel();
                } catch (e) {}
              });
            }
            try {
              el.dispatchEvent(new CustomEvent('astro:unmount'));
            } catch (e) {}
          });
        });
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
