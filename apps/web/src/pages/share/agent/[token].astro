---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SharedAgentConversation } from '../../../components/SharedAgentConversation';

const { token } = Astro.params;
---
<BaseLayout title="Conversation partagée · DevForge">
  {token ? (
    <SharedAgentConversation client:only="preact" token={token} />
  ) : (
    <p class="p-8 text-sm text-[var(--color-ink-muted)]">Lien invalide.</p>
  )}
</BaseLayout>
