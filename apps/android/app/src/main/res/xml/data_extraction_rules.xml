<?xml version="1.0" encoding="utf-8"?>
<!-- Jetons et URL d'instance : jamais sauvegardés ni transférés. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
