DATABASE_URL=sqlite:devforge.db?mode=rwc
HOST=0.0.0.0
PORT=8000

# Lancer le binaire depuis la racine du monorepo pour que sqlite:devforge.db
# pointe vers le même fichier que l’instance existante.

# Executor réel : auto = SSH si DEVFORGE_SSH_HOST, sinon local (jamais stub silencieux)
# DEVFORGE_EXECUTOR=auto
# DEVFORGE_EXECUTOR=local
# DEVFORGE_EXECUTOR=ssh
# DEVFORGE_SSH_HOST=192.168.1.10
# DEVFORGE_SSH_USER=root
# DEVFORGE_SSH_PORT=22
# DEVFORGE_SSH_KEY=C:\Users\you\.ssh\id_ed25519

# GitHub (prioritaire au boot ; sinon token Settings / instance_settings)
# DEVFORGE_GITHUB_TOKEN=ghp_…
# Webhook push → deploy : POST /api/v1/webhooks/github
# DEVFORGE_GITHUB_WEBHOOK_SECRET=…
# DEVFORGE_DATA_DIR=data

# Agents / LLM (OpenAI-compatible)
# DEVFORGE_LLM_PROVIDER=auto|stub|openai|openrouter|ollama
# DEVFORGE_LLM_API_KEY=sk-…
# OPENAI_API_KEY=sk-…   # alias accepté
# DEVFORGE_LLM_MODEL=gpt-4o-mini
# DEVFORGE_LLM_BASE_URL=http://127.0.0.1:11434/v1   # ollama

# Self-update DevForge (réel : compose / docker / binary — plus de stub)
# DEVFORGE_VERSION=2.0.0
# DEVFORGE_UPDATE_REPO=bobdivx/devforge
# DEVFORGE_UPDATE_MODE=auto|compose|docker|binary
# DEVFORGE_UPDATE_IMAGE=ghcr.io/bobdivx/devforge
# DEVFORGE_SELF_CONTAINER=devforge
# DEVFORGE_UPDATE_COMPOSE_FILE=/opt/devforge/docker-compose.yml
# DEVFORGE_UPDATE_COMPOSE_SERVICE=devforge
# DEVFORGE_UPDATE_CHANNEL=stable
# Assets binaires attendus : devforge-server-<rust-target-triple>.zip

# Backups S3 instance : Settings → Sauvegardes (UX), pas de variables d’env.

# Sécurité prod
# DEVFORGE_CORS_ORIGINS=https://devforge.example.com
# DEVFORGE_ALLOW_REGISTER=0
# DEVFORGE_GITHUB_WEBHOOK_SECRET=change-me
# DEVFORGE_ALLOW_INSECURE_WEBHOOK=0
# DEVFORGE_STATIC_DIR=apps/web/dist
# Lab only :
# DEVFORGE_ALLOW_REGISTER=1
# DEVFORGE_ALLOW_INSECURE_WEBHOOK=1

