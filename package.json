{
    "name": "devforge",
    "private": true,
    "type": "module",
    "workspaces": [
        "frontend"
    ],
    "scripts": {
        "dev": "vite --config backend/vite.config.js",
        "dev:laravel": "vite --config backend/vite.config.js",
        "dev:frontend": "npm run dev --workspace frontend",
        "dev:devforge": "npm run dev --workspace frontend",
        "build": "npm run build:laravel && npm run build:frontend",
        "build:laravel": "vite build --config backend/vite.config.js && node scripts/normalize-vite-manifest.mjs",
        "build:frontend": "npm run build --workspace frontend",
        "build:devforge": "npm run build --workspace frontend",
        "test:frontend": "npm run test --workspace frontend",
        "test:devforge": "npm run test --workspace frontend"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.1.18",
        "laravel-vite-plugin": "2.0.1",
        "postcss": "8.5.15",
        "tailwind-scrollbar": "4.0.2",
        "tailwindcss": "4.1.18",
        "vite": "7.3.6"
    },
    "dependencies": {
        "@tailwindcss/forms": "0.5.10",
        "@tailwindcss/typography": "0.5.16",
        "@xterm/addon-fit": "0.10.0",
        "@xterm/xterm": "5.5.0",
        "playwright": "^1.58.2"
    }
}
