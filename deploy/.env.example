# Copier vers .env uniquement pour overrides rares (self-host compose classique).
# Sur ZimaOS : laisse Variables vide — config dans l’UI DevForge.

DEVFORGE_VERSION=2.0.2
DEVFORGE_IMAGE=bobdivx/devforge
DEVFORGE_HTTP_PORT=8000
DEVFORGE_DATA_DIR=./data
DEVFORGE_CONTAINER_NAME=devforge

# Docker network for Traefik reverse-proxy routing.
# Required when deploying apps with Traefik labels.
# Common values: coolify, devforge-net, traefik-public, traefik
# If not set, DevForge will attempt auto-detection (inspects traefik/coolify/caddy containers).
# DEVFORGE_DOCKER_NETWORK=coolify

# DEVFORGE_CORS_ORIGINS=https://devforge.example.com
# DEVFORGE_GITHUB_WEBHOOK_SECRET=change-me
