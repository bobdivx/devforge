---
import Layout from '../layouts/Layout.astro';
import { getAllItems } from '../lib/db';

const items = await getAllItems();
---

<Layout title="Données">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2">Données</h1>
      <p class="text-base-content/70">Éléments stockés dans la base du projet (SQLite en local, PostgreSQL dès qu’une instance est liée).</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">{item.title}</h2>
            <p>{item.description || 'Aucune description'}</p>
            <div class="card-actions justify-end">
              <div class="badge badge-outline">ID: {item.id}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8">
      <a href="/" class="btn btn-ghost">← Retour à l'accueil</a>
    </div>
  </div>
</Layout>
