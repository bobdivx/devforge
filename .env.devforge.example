# Copy to .env (NAS: /media/Docker/AppData/devforge/source/.env) — do not commit secrets.
# Prod: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env up -d

APP_NAME=DevForge
APP_ENV=production
APP_KEY=
APP_URL=http://10.1.0.58:8080
APP_DEBUG=false

DEVFORGE_HTTP_PORT=8080
DEVFORGE_ENABLED=true
DEVFORGE_AGENTS_ENABLED=true

DEVFORGE_API_IMAGE=bobdivx/devforge:latest
DEVFORGE_WEB_IMAGE=bobdivx/devforge:web
DEVFORGE_REALTIME_IMAGE=bobdivx/devforge:realtime
# Pulled on demand by ApplicationDeploymentJob (not a long-running compose service)
HELPER_IMAGE=bobdivx/devforge
# Tag used with HELPER_IMAGE → bobdivx/devforge:helper (see config/constants.php helper_version)

DEVFORGE_DATA_ROOT=/media/Docker/AppData/devforge
DEVFORGE_PLATFORM_DATA=/media/Docker/AppData/devforge/data
DEVFORGE_POSTGRES_DATA=/media/Docker/AppData/devforge/postgres
DEVFORGE_REDIS_DATA=/media/Docker/AppData/devforge/redis
DEVFORGE_ENV_FILE=/media/Docker/AppData/devforge/source/.env

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=devforge
DB_USERNAME=devforge
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PASSWORD=

PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret

DEVFORGE_DISK_WARN_GB=20
DEVFORGE_DISK_PATH=/media/Docker

# Sauvegardes S3 (Scaleway Object Storage). Les clés restent hors git.
# Endpoint path-style : https://s3.fr-par.scw.cloud  (pas https://devforge.s3.fr-par.scw.cloud)
DEVFORGE_BACKUP_S3_ENABLED=false
DEVFORGE_BACKUP_S3_KEY=
DEVFORGE_BACKUP_S3_SECRET=
DEVFORGE_BACKUP_S3_BUCKET=devforge
DEVFORGE_BACKUP_S3_REGION=fr-par
DEVFORGE_BACKUP_S3_ENDPOINT=https://s3.fr-par.scw.cloud
DEVFORGE_BACKUP_S3_NAME=Scaleway backups
DEVFORGE_BACKUP_S3_ATTACH_NEW=true
