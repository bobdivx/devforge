---
import { App } from '../components/App';
import { DEVFORGE_LOGO_URL } from '../lib/brand';
import { staticRoutePaths } from '../lib/routes';
import '../styles/global.css';

export function getStaticPaths() {
    return staticRoutePaths.map((routePath) => ({
        params: {
            path: routePath === '/' ? undefined : routePath.slice(1),
        },
        props: {
            initialPath: routePath,
        },
    }));
}

const { initialPath } = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="Interface DevForge pour administrer la plateforme Coolify." />
        <meta name="theme-color" content="#171717" />
        <link rel="icon" href={DEVFORGE_LOGO_URL} type="image/png" />
        <link rel="apple-touch-icon" href={DEVFORGE_LOGO_URL} />
        <title>DevForge</title>
        <script is:inline>
            (() => {
                const saved = localStorage.getItem('devforge-theme');
                const theme = saved === 'light' || saved === 'dark'
                    ? saved
                    : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
            })();
        </script>
    </head>
    <body>
        <App initialPath={initialPath} client:load />
    </body>
</html>
